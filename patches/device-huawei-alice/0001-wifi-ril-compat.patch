diff --git a/libshim/Android.mk b/libshim/Android.mk
index 015a99a..66449ea 100755
--- a/libshim/Android.mk
+++ b/libshim/Android.mk
@@ -41,6 +41,19 @@ LOCAL_MODULE_TAGS := optional
 LOCAL_MODULE_CLASS := SHARED_LIBRARIES
 include $(BUILD_SHARED_LIBRARY)
 
+# Huawei's Wi-Fi HIDL blobs were linked against the standalone
+# android.hidl.base@1.0.so SONAME. Android 8.1 exports the implementation
+# from libhidltransport instead, so provide the expected SONAME as a small
+# compatibility library. The vendor blob already links libhidltransport and
+# resolves the HIDL Base symbols from it.
+include $(CLEAR_VARS)
+LOCAL_SRC_FILES := hidl_base_compat.cpp
+LOCAL_MODULE := android.hidl.base@1.0
+LOCAL_MULTILIB := 64
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_CLASS := SHARED_LIBRARIES
+include $(BUILD_SHARED_LIBRARY)
+
 include $(CLEAR_VARS)
 LOCAL_SRC_FILES := \
     gui/SensorManager.cpp \
diff --git a/libshim/hidl_base_compat.cpp b/libshim/hidl_base_compat.cpp
new file mode 100644
index 0000000..aaa3173
--- /dev/null
+++ b/libshim/hidl_base_compat.cpp
@@ -0,0 +1,10 @@
+/*
+ * Compatibility SONAME for the Huawei Wi-Fi HIDL implementation.
+ *
+ * Android 8.1 provides android.hidl.base@1.0 through libhidltransport. The
+ * vendor Wi-Fi library still declares a separate android.hidl.base@1.0.so
+ * dependency, so this intentionally small shared library satisfies that
+ * dependency while the real symbols come from the already-required
+ * libhidltransport.so.
+ */
+extern "C" void android_hidl_base_compat_anchor() {}
